{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blockmarket.local/schemas/tournament-request.v1.schema.json",
  "title": "BlockMarket tournament request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["tournament_id", "blocks", "seed_count", "runner_limits", "participants"],
  "properties": {
    "tournament_id": {"$ref": "#/$defs/id"},
    "blocks": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "seed_count": {"type": "integer", "minimum": 1, "maximum": 100},
    "runner_limits": {"$ref": "#/$defs/limits"},
    "participants": {
      "type": "array", "minItems": 2, "maxItems": 16,
      "items": {"$ref": "#/$defs/participant"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$"},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_timeout_ms", "max_stdout_bytes", "max_stderr_bytes"],
      "properties": {
        "decision_timeout_ms": {"type": "integer", "minimum": 1},
        "max_stdout_bytes": {"type": "integer", "minimum": 128},
        "max_stderr_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "participant": {
      "type": "object", "additionalProperties": false,
      "required": ["participant_id", "source", "command"],
      "properties": {
        "participant_id": {"$ref": "#/$defs/id"},
        "source": {"type": "string", "minLength": 1},
        "entrypoint": {"type": "string", "minLength": 1},
        "command": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "contains": {"type": "string", "pattern": "\\{(?:entrypoint|submission)\\}"}
        }
      }
    }
  }
}
