{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blockmarket.local/schemas/action.v1.schema.json",
  "title": "BlockMarket action.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_seq", "bid", "ask"],
  "properties": {
    "decision_seq": {"type": "integer", "minimum": 1},
    "bid": {"$ref": "#/$defs/nullableQuote"},
    "ask": {"$ref": "#/$defs/nullableQuote"}
  },
  "$defs": {
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price", "quantity"],
      "properties": {
        "price": {"type": "string", "pattern": "^(?:(?:5[0-9]|[6-9][0-9]|1[0-4][0-9])\\.[0-9]{2}|150\\.00)$"},
        "quantity": {"type": "string", "pattern": "^(?:[1-9]|10)$"}
      }
    },
    "nullableQuote": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/quote"}]}
  }
}
