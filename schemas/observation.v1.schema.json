{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blockmarket.local/schemas/observation.v1.schema.json",
  "title": "BlockMarket observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "ruleset", "match_id", "player_id", "block_seq",
    "remaining_blocks", "reference_price", "reference_history",
    "market_signal", "signal_history", "last_fills", "cumulative_volume",
    "account", "limits"
  ],
  "properties": {
    "schema": {"const": "observation.v1"},
    "ruleset": {"const": "blockmarket-v1-prototype.2"},
    "match_id": {"type": "string"},
    "player_id": {"enum": ["A", "B"]},
    "block_seq": {"type": "integer", "minimum": 1},
    "remaining_blocks": {"type": "integer", "minimum": 1},
    "reference_price": {"$ref": "#/$defs/price"},
    "reference_history": {
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/price"}
    },
    "market_signal": {"enum": ["UP", "DOWN"]},
    "signal_history": {
      "type": "array", "minItems": 1,
      "items": {"enum": ["UP", "DOWN"]}
    },
    "last_fills": {
      "type": "array", "maxItems": 2,
      "items": {"$ref": "event.v1.schema.json#/$defs/fill"}
    },
    "cumulative_volume": {
      "type": "object", "additionalProperties": false,
      "required": ["A", "B"],
      "properties": {
        "A": {"type": "string", "pattern": "^[0-9]+$"},
        "B": {"type": "string", "pattern": "^[0-9]+$"}
      }
    },
    "account": {"$ref": "event.v1.schema.json#/$defs/account"},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["price_range", "price_tick", "inventory_range", "max_quote_quantity"],
      "properties": {
        "price_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/price"}},
        "price_tick": {"const": "0.01"},
        "inventory_range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
        "max_quote_quantity": {"type": "string"}
      }
    }
  },
  "$defs": {
    "price": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"}
  }
}
